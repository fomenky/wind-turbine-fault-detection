# Language-bar classification (GitHub Linguist)
#
# The full report under reports/ is a generated artifact exported from the
# Jupyter notebook (a single ~2 MB auto-generated HTML file), so it is excluded
# from the language stats — it would otherwise dominate the bar and misrepresent
# the work. The hand-written executive summary (index.html, real HTML/CSS) and
# the notebook ARE counted, so the language bar reflects Jupyter Notebook + HTML.

reports/*.html linguist-generated=true

# Count the notebook and the hand-authored summary page.
*.ipynb linguist-detectable=true
index.html linguist-detectable=true
