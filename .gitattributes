# Language-bar classification (GitHub Linguist)
# The HTML reports are generated artifacts exported from the Jupyter notebook,
# not hand-written source. Exclude them so the language bar reflects the actual
# work (Python / Jupyter Notebook) rather than the large generated HTML export.

reports/*.html linguist-generated=true
index.html     linguist-documentation=true

# Ensure the notebook is counted toward language stats.
*.ipynb linguist-detectable=true
*.ipynb linguist-language=Jupyter\ Notebook
